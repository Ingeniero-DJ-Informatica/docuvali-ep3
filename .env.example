# Copiar a .env y completar. NUNCA subir .env a GitHub.
API_KEYS=cambia-esta-clave-larga,clave-del-dashboard
DASHBOARD_API_KEY=clave-del-dashboard
RATE_LIMIT_POR_MIN=120
RABBITMQ_USER=docuvali
