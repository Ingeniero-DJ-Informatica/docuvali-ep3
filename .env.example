# AWS (en EC2 con LabInstanceProfile no se necesitan claves)
AWS_REGION=us-east-1
EXTRACTOR=textract            # textract | simulado
PREDICTOR=sagemaker           # sagemaker | local
SAGEMAKER_ENDPOINT=docuvali-endpoint
